# Copy to .env.local (never commit it) to use AI minds with `npm run dev` or the relay.
# On Vercel, add these under Project → Settings → Environment Variables instead.
DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_MODEL=deepseek-flash
# LLM_PASSWORD=choose-a-password     # players must enter it to use this key
# LLM_RATE_PER_MIN=90                # requests per minute per IP using the server key
